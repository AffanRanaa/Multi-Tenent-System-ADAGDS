<!DOCTYPE html>
<html lang="en" data-layout="{{LAYOUT}}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{APP_NAME}}</title>
  <link rel="stylesheet" href="styles.css" />
</head>
<body>
  <header class="app-header">
    <div class="logo">{{LOGO_TEXT}}</div>
    <nav class="app-nav">
      <span class="badge">{{STAGE}}</span>
      <span class="badge">v{{VERSION}}</span>
    </nav>
  </header>

  <main class="app-main">
    <section class="hero">
      <h1>{{APP_NAME}}</h1>
      <p class="subtitle">Independently generated by ADAGDS &middot; tenant {{TENANT_ID}}</p>
    </section>

    <section class="panels">
      <article class="panel">
        <h2>Feature Flags</h2>
        <ul id="features"></ul>
      </article>
      <article class="panel">
        <h2>Environment</h2>
        <ul id="environment"></ul>
      </article>
      <article class="panel">
        <h2>Data Source</h2>
        <ul id="dataSource"></ul>
      </article>
    </section>
  </main>

  <footer class="app-footer">
    <span>Layout: {{LAYOUT}}</span>
    <span id="served-at"></span>
  </footer>

  <script src="app.js"></script>
</body>
</html>
