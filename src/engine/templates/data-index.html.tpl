<!DOCTYPE html>
<html lang="en" data-layout="{{LAYOUT}}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{APP_NAME}}</title>
  <link rel="stylesheet" href="styles.css" />
</head>
<body>
  <header class="app-header">
    <div class="logo">{{LOGO_TEXT}}</div>
    <nav class="app-nav">
      <span class="badge">{{STAGE}}</span>
      <span class="badge" id="count-badge">loading…</span>
    </nav>
  </header>

  <main class="app-main">
    <section class="hero">
      <h1>{{APP_NAME}}</h1>
      <p class="subtitle">Independent data app generated by ADAGDS &middot; tenant {{TENANT_ID}}</p>
    </section>

    <input id="search" class="search" type="search" placeholder="Search this app's records…" />
    <section id="records" class="records"></section>
  </main>

  <footer class="app-footer">
    <span>Layout: {{LAYOUT}}</span>
    <span id="served-at"></span>
  </footer>

  <script src="app.js"></script>
</body>
</html>
