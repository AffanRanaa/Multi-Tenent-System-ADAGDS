{
  "id": "tenant-07",
  "name": "Slate Docs",
  "slug": "slate-docs",
  "version": "0.9.0",
  "features": {
    "auth": false,
    "darkMode": true,
    "analytics": false,
    "exportCsv": true,
    "notifications": false
  },
  "environment": {
    "stage": "development",
    "region": "us-west-1",
    "logLevel": "debug"
  },
  "dataSource": {
    "type": "file",
    "endpoint": "local://slate/content",
    "cacheTtlSeconds": 300
  },
  "theme": {
    "primaryColor": "#475569",
    "accentColor": "#64748b",
    "layout": "minimal",
    "fontFamily": "Georgia, serif",
    "logoText": "Slate"
  }
}
